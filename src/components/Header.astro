---
import { vistas, type Vista } from "../data/profile";

interface Props {
  vista: Vista;
}

const { vista } = Astro.props;

/* "Inicio" siempre lleva al hero de la vista principal; "Contacto", a la
   sección de contacto de la vista en la que se está. */
const actual = vistas[vista].href;
const navItems = [
  { name: "Inicio", href: "/#inicio", activa: false },
  { name: vistas["sobre-mi"].nombre, href: vistas["sobre-mi"].href, activa: vista === "sobre-mi" },
  { name: vistas.academico.nombre, href: vistas.academico.href, activa: vista === "academico" },
  { name: "Contacto", href: `${actual}#contacto`, activa: false },
];
---

<header class="site-header" data-header data-scrolled="false">
  <div class="header-inner shell">
    <nav class="nav" aria-label="Navegación principal">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={["nav-link", item.activa && "is-active"]}
            aria-current={item.activa ? "page" : undefined}
          >
            <span class="nav-link-text">{item.name}</span>
          </a>
        ))
      }
    </nav>

    <button
      class="menu-btn"
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="menu-movil"
      aria-label="Abrir menú"
    >
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>

  <div class="progress" data-progress aria-hidden="true"></div>
</header>

<div class="menu-panel" id="menu-movil" data-menu-panel hidden>
  <nav class="menu-nav" aria-label="Navegación móvil">
    {
      navItems.map((item, i) => (
        <a
          href={item.href}
          class="menu-link"
          style={`--i:${i}`}
          aria-current={item.activa ? "page" : undefined}
        >
          <span class="menu-index">{String(i + 1).padStart(2, "0")}</span>
          {item.name}
        </a>
      ))
    }
  </nav>
</div>

<style>
  /* Barra blanca siempre visible: la navegación se lee igual sobre
     cualquier zona de la malla. */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: var(--header-h);
    display: flex;
    align-items: center;
    background: var(--surface-raised);
    backdrop-filter: blur(14px) saturate(160%);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    border-bottom: 1px solid var(--line);
    transition: box-shadow 0.4s var(--ease);
  }

  .site-header[data-scrolled="true"] {
    box-shadow: var(--shadow-sm);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  @media (min-width: 900px) {
    .header-inner {
      justify-content: center;
    }
  }

  /* ── Navegación ───────────────────────────────────────────── */
  .nav {
    display: none;
    align-items: center;
    gap: 0.25rem;
  }

  @media (min-width: 900px) {
    .nav {
      display: flex;
    }
  }

  .nav-link {
    position: relative;
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-muted);
    transition: color 0.3s var(--ease);
  }

  .nav-link::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    opacity: 0;
    transform: scale(0.9);
    transition: opacity 0.35s var(--ease), transform 0.35s var(--ease);
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--ink);
  }

  .nav-link.is-active::before {
    opacity: 1;
    transform: scale(1);
  }

  .nav-link-text {
    position: relative;
  }

  /* ── Botón de menú (móvil) ────────────────────────────────── */
  .menu-btn {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-soft);
  }

  @media (min-width: 900px) {
    .menu-btn {
      display: none;
    }
  }

  .bar {
    display: block;
    width: 16px;
    height: 1.8px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.3s var(--ease);
  }

  .menu-btn[aria-expanded="true"] .bar:first-child {
    transform: translateY(3.4px) rotate(45deg);
  }

  .menu-btn[aria-expanded="true"] .bar:last-child {
    transform: translateY(-3.4px) rotate(-45deg);
  }

  /* ── Progreso de lectura ──────────────────────────────────── */
  .progress {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 2px;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: linear-gradient(
      90deg,
      var(--color-violet),
      var(--color-azure),
      var(--accent)
    );
  }

  /* ── Panel móvil ──────────────────────────────────────────── */
  .menu-panel {
    position: fixed;
    inset: 0;
    z-index: 45;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(22px) saturate(150%);
    -webkit-backdrop-filter: blur(22px) saturate(150%);
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }

  .menu-panel[data-open="true"] {
    opacity: 1;
  }

  .menu-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    width: min(24rem, 82vw);
  }

  .menu-link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
    font-size: clamp(1.6rem, 8vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    color: var(--ink);
    opacity: 0;
    transform: translateY(8px);
    transition: color 0.3s var(--ease);
  }

  .menu-panel[data-open="true"] .menu-link {
    animation: menu-in 0.5s var(--ease) forwards;
    animation-delay: calc(var(--i) * 50ms + 60ms);
  }

  .menu-link:hover,
  .menu-link[aria-current="page"] {
    color: var(--accent-strong);
  }

  .menu-index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--accent-strong);
  }

  @keyframes menu-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
