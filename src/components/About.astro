---
import SectionHeading from "./SectionHeading.astro";
import {
  intro,
  intereses,
  accents,
  skills,
  formacionAcademica,
  trayectoriaIntro,
  trayectoriaAcademica,
  trayectoriaLaboral,
} from "../data/profile";
---

<section id="sobre-mi" class="section">
  <div class="shell sheet">
    <SectionHeading eyebrow="01 — Perfil" title="Sobre mí" />

    <blockquote class="intro" data-reveal>{intro}</blockquote>

    <ul class="tags" data-reveal style="--reveal-delay:80ms">
      {
        intereses.map((interes, i) => (
          <li>
            <span
              class="chip"
              style={`--chip-color:${accents[i % accents.length]}`}
            >
              {interes}
            </span>
          </li>
        ))
      }
    </ul>

    <!-- ── Habilidades ─────────────────────────────────────── -->
    <div class="skills">
      {
        skills.map((skill, i) => (
          <article
            class="card skill"
            data-spotlight
            data-reveal
            style={`--reveal-delay:${i * 70}ms; --chip-color:${accents[i % accents.length]}`}
          >
            <span class="skill-num">{skill.num}</span>
            <h3 class="skill-title">{skill.titulo}</h3>
            <ul class="skill-items">
              {skill.items.map((item) => (
                <li>
                  <span class="dot" />
                  {item}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <!-- ── Formación académica ─────────────────────────────── -->
    <h3 class="sub-title" data-reveal>Formación académica</h3>
    <ol class="edu">
      {
        formacionAcademica.map((item, i) => (
          <li
            class="card edu-item"
            data-spotlight
            data-reveal
            style={`--reveal-delay:${i * 60}ms`}
          >
            <span class="edu-year">{item.ano}</span>
            <div class="edu-body">
              <p class="edu-program">{item.programa}</p>
              <p class="edu-school">{item.institucion}</p>
            </div>
            {item.tipo && <span class="chip chip--mono edu-badge">{item.tipo}</span>}
          </li>
        ))
      }
    </ol>

    <!-- ── Trayectoria ─────────────────────────────────────── -->
    <h3 class="sub-title" data-reveal>Trayectoria académica</h3>
    <p class="prose-p trajectory-intro" data-reveal>{trayectoriaIntro}</p>

    <div class="timeline">
      {
        trayectoriaAcademica.map((item) => (
          <details class="event" data-reveal>
            <summary class="event-summary">
              <span class="event-year">{item.ano}</span>
              <span class="event-title">{item.titulo}</span>
              <span class="event-icon" aria-hidden="true">&gt;_</span>
            </summary>

            <div class="event-body">
              {item.descripcion.map((parrafo) => (
                <p class="prose-p">{parrafo}</p>
              ))}

              {item.imagenes && (
                <div
                  class:list={[
                    "event-media",
                    item.imagenes.length > 1 && "event-media--grid",
                  ]}
                >
                  {item.imagenes.map((img) => (
                    <img
                      src={img.src}
                      alt={img.alt}
                      loading="lazy"
                      decoding="async"
                    />
                  ))}
                </div>
              )}

              {item.destacado && (
                <aside class="highlight">
                  <span class="highlight-label">Punto clave</span>
                  <p class="highlight-text">{item.destacado}</p>
                </aside>
              )}

              {item.linkUrl && (
                <a
                  href={item.linkUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn--sm"
                >
                  {item.linkText}
                </a>
              )}
            </div>
          </details>
        ))
      }
    </div>

    <!-- ── Experiencia ─────────────────────────────────────── -->
    <h3 class="sub-title" data-reveal>Experiencia</h3>
    <ol class="work">
      {
        trayectoriaLaboral.map((item, i) => (
          <li class="work-item" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <span class="work-year">{item.ano}</span>
            <div class="work-body">
              <h4 class="work-role">{item.rol}</h4>
              {item.empresa && <p class="work-company">{item.empresa}</p>}
              <p class="prose-p">{item.descripcion}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* ── Introducción ─────────────────────────────────────────── */
  .intro {
    margin: 0 0 1.75rem;
    padding-left: 1.35rem;
    border-left: 3px solid var(--accent);
    font-size: clamp(1.15rem, 2.4vw, 1.6rem);
    font-weight: 500;
    line-height: 1.55;
    color: var(--ink);
    max-width: 52ch;
    text-wrap: pretty;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 0 0 3.25rem;
    padding: 0;
  }

  /* ── Tarjeta base con foco de luz ─────────────────────────── */
  .card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.35s var(--ease), border-color 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }

  /* El resplandor sigue al cursor mediante --mx/--my (ui.ts). */
  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      16rem circle at var(--mx, 50%) var(--my, 50%),
      color-mix(in srgb, var(--chip-color, var(--accent)) 16%, transparent),
      transparent 70%
    );
    transition: opacity 0.35s var(--ease);
  }

  .card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--chip-color, var(--accent)) 45%, var(--line));
    box-shadow: var(--shadow-md);
  }

  .card:hover::before {
    opacity: 1;
  }

  /* ── Habilidades ──────────────────────────────────────────── */
  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
  }

  .skill {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.5rem 1.35rem;
    /* Palabras largas ("Optimización", "Computación científica") no
       desbordan la tarjeta en pantallas angostas. */
    overflow-wrap: break-word;
  }

  .skill-num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--chip-color, var(--accent));
  }

  .skill-title {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .skill-items {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .skill-items li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink-soft);
    line-height: 1.45;
  }

  .dot {
    flex-shrink: 0;
    width: 5px;
    height: 5px;
    margin-top: 0.5em;
    border-radius: 999px;
    background: var(--chip-color, var(--accent));
  }

  /* ── Subtítulos ───────────────────────────────────────────── */
  .sub-title {
    margin: 4.5rem 0 1.75rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--line);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  /* ── Formación ────────────────────────────────────────────── */
  .edu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .edu-item {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 0.35rem 1.25rem;
    padding: 1.1rem 1.35rem;
  }

  @media (min-width: 700px) {
    .edu-item {
      grid-template-columns: 8.5rem 1fr auto;
      gap: 1.5rem;
    }
  }

  .edu-year {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--accent-strong);
    white-space: nowrap;
  }

  .edu-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .edu-program {
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .edu-school {
    font-size: 0.85rem;
    color: var(--ink-muted);
  }

  .edu-badge {
    justify-self: start;
    --chip-color: var(--ink-muted);
  }

  /* ── Trayectoria ──────────────────────────────────────────── */
  .trajectory-intro {
    max-width: 68ch;
    margin-bottom: 2.5rem;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    position: relative;
    padding-left: 1.35rem;
  }

  /* Raíl vertical que hilvana los eventos. */
  .timeline::before {
    content: "";
    position: absolute;
    top: 0.75rem;
    bottom: 0.75rem;
    left: 3px;
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--line-strong) 12%,
      var(--line-strong) 88%,
      transparent
    );
  }

  .event {
    position: relative;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--line);
  }

  .event:last-child {
    border-bottom: 0;
  }

  .event::before {
    content: "";
    position: absolute;
    left: -1.35rem;
    top: 2.05rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--surface);
    border: 2px solid var(--line-strong);
    transition: border-color 0.3s var(--ease), background 0.3s var(--ease);
  }

  .event[open]::before {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .event-summary {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.2rem 1rem;
    cursor: pointer;
    list-style: none;
  }

  .event-summary::-webkit-details-marker {
    display: none;
  }

  .event-year {
    grid-column: 1 / -1;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--ink-faint);
  }

  .event-title {
    font-size: clamp(1.25rem, 3vw, 1.7rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    color: var(--ink);
    transition: color 0.25s var(--ease);
  }

  .event-summary:hover .event-title {
    color: var(--accent-strong);
  }

  /* El símbolo de consola gira 90° y se pone verde al abrirse. */
  .event-icon {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--ink-faint);
    transition: transform 0.35s var(--ease), color 0.3s var(--ease);
  }

  .event-summary:hover .event-icon {
    color: var(--ink-muted);
  }

  .event[open] .event-icon {
    transform: rotate(90deg);
    color: var(--accent);
  }

  .event-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
    margin-top: 1.1rem;
    animation: unfold 0.45s var(--ease);
  }

  @keyframes unfold {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  .event-body .prose-p {
    max-width: 68ch;
  }

  .event-media {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
    width: 100%;
    max-width: 34rem;
  }

  @media (min-width: 640px) {
    .event-media--grid {
      grid-template-columns: repeat(2, 1fr);
      max-width: 46rem;
    }
  }

  .event-media img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }

  .event-media img:hover {
    transform: scale(1.015);
    box-shadow: var(--shadow-md);
  }

  .highlight {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.2rem;
    max-width: 62ch;
    border-radius: 0 var(--radius) var(--radius) 0;
    border-left: 3px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }

  .highlight-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }

  .highlight-text {
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.55;
    color: var(--ink);
  }

  /* ── Experiencia ──────────────────────────────────────────── */
  .work {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .work-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.35rem 1.5rem;
    padding-left: 1.1rem;
    border-left: 2px solid var(--line);
    transition: border-color 0.3s var(--ease);
  }

  .work-item:hover {
    border-left-color: var(--accent);
  }

  @media (min-width: 700px) {
    .work-item {
      grid-template-columns: 8.5rem 1fr;
    }
  }

  .work-year {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    padding-top: 0.35rem;
  }

  .work-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    max-width: 62ch;
  }

  .work-role {
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .work-company {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent-strong);
  }
</style>
