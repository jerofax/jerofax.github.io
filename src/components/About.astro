---
import SectionHeading from "./SectionHeading.astro";
import { intro, intereses, accents, skills, formacionAcademica } from "../data/profile";
---

<section id="sobre-mi" class="section">
  <div class="shell sheet">
    <SectionHeading eyebrow="01 — Perfil" title="Sobre mí" />

    <blockquote class="intro" data-reveal>{intro}</blockquote>

    <ul class="tags" data-reveal style="--reveal-delay:80ms">
      {
        intereses.map((interes, i) => (
          <li>
            <span
              class="chip"
              style={`--chip-color:${accents[i % accents.length]}`}
            >
              {interes}
            </span>
          </li>
        ))
      }
    </ul>

    <!-- ── Habilidades ─────────────────────────────────────── -->
    <div class="skills">
      {
        skills.map((skill, i) => (
          <article
            class="card skill"
            data-spotlight
            data-reveal
            style={`--reveal-delay:${i * 70}ms; --chip-color:${accents[i % accents.length]}`}
          >
            <span class="skill-num">{skill.num}</span>
            <h3 class="skill-title">{skill.titulo}</h3>
            <ul class="skill-items">
              {skill.items.map((item) => {
                const texto = typeof item === "string" ? item : item.texto;
                const enExploracion = typeof item !== "string";
                return (
                  <li>
                    <span class="dot" />
                    <span>
                      {texto}
                      {enExploracion && <span class="explore">en exploración</span>}
                    </span>
                  </li>
                );
              })}
            </ul>
          </article>
        ))
      }
    </div>

    <!-- ── Formación académica ─────────────────────────────── -->
    <h3 class="sub-title" data-reveal>Formación académica</h3>
    <ol class="edu">
      {
        formacionAcademica.map((item, i) => (
          <li
            class="card edu-item"
            data-spotlight
            data-reveal
            style={`--reveal-delay:${i * 60}ms`}
          >
            <span class="edu-year">{item.ano}</span>
            <div class="edu-body">
              <p class="edu-program">{item.programa}</p>
              <p class="edu-school">{item.institucion}</p>
            </div>
            {item.tipo && <span class="chip chip--mono edu-badge">{item.tipo}</span>}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* ── Introducción ─────────────────────────────────────────── */
  .intro {
    margin: 0 0 1.75rem;
    padding-left: 1.35rem;
    border-left: 3px solid var(--accent);
    font-size: clamp(1.15rem, 2.4vw, 1.6rem);
    font-weight: 500;
    line-height: 1.55;
    color: var(--ink);
    max-width: 52ch;
    text-wrap: pretty;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 0 0 3.25rem;
    padding: 0;
  }

  /* ── Tarjeta base con foco de luz ─────────────────────────── */
  .card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.35s var(--ease), border-color 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }

  /* El resplandor sigue al cursor mediante --mx/--my (ui.ts). */
  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      16rem circle at var(--mx, 50%) var(--my, 50%),
      color-mix(in srgb, var(--chip-color, var(--accent)) 16%, transparent),
      transparent 70%
    );
    transition: opacity 0.35s var(--ease);
  }

  .card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--chip-color, var(--accent)) 45%, var(--line));
    box-shadow: var(--shadow-md);
  }

  .card:hover::before {
    opacity: 1;
  }

  /* ── Habilidades ──────────────────────────────────────────── */
  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
  }

  .skill {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.5rem 1.35rem;
    /* Palabras largas ("Optimización", "Computación científica") no
       desbordan la tarjeta en pantallas angostas. */
    overflow-wrap: break-word;
  }

  .skill-num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--chip-color, var(--accent));
  }

  .skill-title {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .skill-items {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .skill-items li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink-soft);
    line-height: 1.45;
  }

  .dot {
    flex-shrink: 0;
    width: 5px;
    height: 5px;
    margin-top: 0.5em;
    border-radius: 999px;
    background: var(--chip-color, var(--accent));
  }

  /* Insignia sobria para lo que aún se está explorando. */
  .explore {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0.05rem 0.45rem;
    border: 1px dashed var(--line-strong);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    vertical-align: 0.12em;
    white-space: nowrap;
    color: var(--ink-muted);
  }

  /* ── Subtítulos ───────────────────────────────────────────── */
  .sub-title {
    margin: 4.5rem 0 1.75rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--line);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  /* ── Formación ────────────────────────────────────────────── */
  .edu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .edu-item {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 0.35rem 1.25rem;
    padding: 1.1rem 1.35rem;
  }

  @media (min-width: 700px) {
    .edu-item {
      grid-template-columns: 8.5rem 1fr auto;
      gap: 1.5rem;
    }
  }

  .edu-year {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--accent-strong);
    white-space: nowrap;
  }

  .edu-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .edu-program {
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .edu-school {
    font-size: 0.85rem;
    color: var(--ink-muted);
  }

  .edu-badge {
    justify-self: start;
    --chip-color: var(--ink-muted);
  }
</style>
