---
import SectionHeading from "./SectionHeading.astro";
import ProjectCard from "./ProjectCard.astro";
import { proyectos } from "../data/profile";

/* Cuántos proyectos se ven sin desplegar "Ver más". */
const PROYECTOS_VISIBLES = 4;

const visibles = proyectos.slice(0, PROYECTOS_VISIBLES);
const extra = proyectos.slice(PROYECTOS_VISIBLES);
---

<section id="proyectos" class="section">
  <div class="shell sheet">
    <SectionHeading
      eyebrow="02 — Trabajo"
      title="Proyectos"
      lead="Cosas que he construido o que estoy investigando ahora mismo, entre las matemáticas, el código y la ciencia computacional."
    />

    <div class="grid">
      {visibles.map((proyecto, i) => <ProjectCard proyecto={proyecto} index={i} delay={i * 80} />)}
    </div>

    {
      extra.length > 0 && (
        <>
          {/* Plegado con grid-template-rows (0fr → 1fr) para animar la altura
              sin medirla. Cerrado queda con visibility: hidden, así sus
              enlaces no reciben foco ni los anuncia un lector de pantalla. */}
          <div class="more" id="proyectos-mas" data-open="false">
            <div class="more-inner">
              <div class="grid more-grid">
                {extra.map((proyecto, i) => (
                  <ProjectCard
                    proyecto={proyecto}
                    index={PROYECTOS_VISIBLES + i}
                    delay={i * 80}
                  />
                ))}
              </div>
            </div>
          </div>

          <div class="more-actions">
            <button
              type="button"
              class="btn btn--ghost more-toggle"
              aria-expanded="false"
              aria-controls="proyectos-mas"
              data-more-toggle
              data-label-closed="Ver más"
              data-label-open="Ver menos"
            >
              <span data-more-label>Ver más</span>
              <span class="sr-only"> proyectos</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6 9l6 6 6-6" />
              </svg>
            </button>
          </div>

          {/* Sin JavaScript no hay forma de desplegar: se muestran todos. */}
          <noscript>
            <style is:inline>
              #proyectos-mas { grid-template-rows: 1fr !important; opacity: 1 !important; visibility: visible !important; }
              [data-more-toggle] { display: none !important; }
            </style>
          </noscript>
        </>
      )
    }
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1.1rem;
  }

  /* ── Ver más ──────────────────────────────────────────────── */
  .more {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
    /* Al cerrar, visibility cambia al final para no cortar la transición. */
    transition: grid-template-rows 0.5s var(--ease), opacity 0.35s var(--ease),
      visibility 0s linear 0.5s;
  }

  .more[data-open="true"] {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
    transition: grid-template-rows 0.5s var(--ease), opacity 0.45s var(--ease) 0.05s,
      visibility 0s linear 0s;
  }

  .more-inner {
    min-height: 0;
    overflow: hidden;
  }

  /* El hueco entre los dos grupos va dentro del plegado: cerrado, no deja
     espacio; abierto, iguala el espacio entre tarjetas. */
  .more-grid {
    padding-top: 1.1rem;
  }

  .more-actions {
    display: flex;
    justify-content: center;
    margin-top: 1.75rem;
  }

  .more-toggle svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.35s var(--ease);
  }

  .more-toggle[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }
</style>
