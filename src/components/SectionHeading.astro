---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<header class="heading" data-reveal>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="section-title">{title}</h2>
  {lead && <p class="section-lead">{lead}</p>}
</header>

<style>
  .heading {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 2.75rem;
  }
</style>
