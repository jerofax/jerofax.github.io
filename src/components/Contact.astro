---
import { site } from "../data/profile";

interface Props {
  /** Numeración de la sección dentro de la vista en la que aparece. */
  eyebrow?: string;
}

const { eyebrow = "04 — Contacto" } = Astro.props;
---

<section id="contacto" class="section">
  <div class="shell sheet panel" data-spotlight data-reveal>
    <p class="eyebrow">{eyebrow}</p>

    <h2 class="headline">
      Hablemos de<br />
      <span class="accent">matemáticas, código o ideas.</span>
    </h2>

    <p class="lead">
      Estoy abierto a colaboraciones en investigación, proyectos de
      computación científica y conversaciones que no lleven a ninguna parte
      pero valgan la pena.
    </p>

    <div class="links">
      <a class="btn" href={`mailto:${site.email}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="m3 7 9 6 9-6"></path>
        </svg>
        Escríbeme
      </a>

      <a
        class="btn btn--ghost"
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.9a3.4 3.4 0 0 0-.9-2.6c3-.3 6.2-1.5 6.2-6.7A5.2 5.2 0 0 0 19.9 5a4.9 4.9 0 0 0-.1-3.6s-1.1-.3-3.7 1.4a12.7 12.7 0 0 0-6.6 0C6.9 1.1 5.8 1.4 5.8 1.4A4.9 4.9 0 0 0 5.7 5a5.2 5.2 0 0 0-1.4 3.6c0 5.2 3.2 6.4 6.2 6.7a3.4 3.4 0 0 0-.9 2.6V22"
          ></path>
        </svg>
        GitHub
      </a>
    </div>

    <address class="detail">
      <a href={`mailto:${site.email}`} class="mail">{site.email}</a>
      <span class="place">{site.location}</span>
    </address>
  </div>
</section>

<style>
  .panel {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
    overflow: hidden;
  }

  .panel::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      26rem circle at var(--mx, 50%) var(--my, 50%),
      color-mix(in srgb, var(--accent) 14%, transparent),
      transparent 68%
    );
    transition: opacity 0.4s var(--ease);
  }

  .panel:hover::before {
    opacity: 1;
  }

  .headline {
    font-size: clamp(1.9rem, 5.5vw, 3.2rem);
    letter-spacing: -0.045em;
    line-height: 1.05;
    color: var(--ink);
  }

  .accent {
    background: linear-gradient(
      100deg,
      var(--color-violet),
      var(--color-azure) 45%,
      var(--accent-strong)
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .lead {
    max-width: 52ch;
    font-size: clamp(0.98rem, 1.5vw, 1.1rem);
    line-height: 1.7;
    color: var(--ink-soft);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
    position: relative;
    z-index: 1;
  }

  .links svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .detail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    width: 100%;
    border-top: 1px solid var(--line);
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-muted);
    position: relative;
    z-index: 1;
  }

  .mail {
    color: var(--ink-soft);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
    transition: color 0.3s var(--ease), text-decoration-color 0.3s var(--ease);
    word-break: break-all;
  }

  .mail:hover {
    color: var(--accent-strong);
    text-decoration-color: var(--accent);
  }

  .place {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .place::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
