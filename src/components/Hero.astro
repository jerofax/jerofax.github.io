---
import { site, accents, vistas, type Vista } from "../data/profile";

interface Props {
  vista: Vista;
}

const { vista } = Astro.props;

/* Proyectos sólo existe en la vista "Sobre mí": desde ahí el botón baja
   con scroll suave; desde "Académico" lleva a esa vista, a la sección. */
const proyectosHref = vista === "sobre-mi" ? "#proyectos" : `${vistas["sobre-mi"].href}#proyectos`;

/* Enlace discreto, junto a los botones, para pasar a la otra vista. */
const cambio =
  vista === "academico"
    ? { href: vistas["sobre-mi"].href, texto: "Volver a Sobre mí", haciaAtras: true }
    : { href: vistas.academico.href, texto: "Ver trayectoria académica y notas", haciaAtras: false };
---

<section id="inicio" class="hero">
  <div class="shell sheet hero-grid">
    <div class="hero-main">
      <p class="status" data-reveal>
        <span class="status-dot"></span>
        Estudiante · {site.location}
      </p>

      <h1 class="name">
        <span class="name-line" data-reveal style="--reveal-delay:60ms">
          <span class="name-first">{site.firstName}</span>
        </span>
        <span class="name-line" data-reveal style="--reveal-delay:160ms">
          <span class="name-last">{site.lastName}</span>
        </span>
      </h1>

      <p class="roles" data-reveal style="--reveal-delay:260ms">
        {
          site.roles.map((role, i) => (
            <span class="role">
              <span class="role-dot" style={`background:${accents[i % accents.length]}`} />
              {role}
            </span>
          ))
        }
      </p>

      <p class="tagline" data-reveal style="--reveal-delay:340ms">
        {site.tagline}
      </p>

      <div class="cta" data-reveal style="--reveal-delay:420ms">
        <a href="#contacto" class="btn">
          Contactar
          <svg viewBox="0 0 24 24" class="btn-icon" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
        <a href={proyectosHref} class="btn btn--ghost">Ver proyectos</a>
        <a
          href={site.cv}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--ghost"
        >
          Ver CV
        </a>
      </div>

      <a href={cambio.href} class="view-switch" data-reveal style="--reveal-delay:480ms">
        {cambio.haciaAtras && (
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
        )}
        {cambio.texto}
        {!cambio.haciaAtras && (
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        )}
      </a>
    </div>

    <div class="hero-portrait" data-reveal style="--reveal-delay:220ms">
      <div class="frame">
        <span class="corner corner--tl"></span>
        <span class="corner corner--br"></span>
        <div class="photo">
          <img
            src={site.photo}
            alt={`Retrato de ${site.name}`}
            width="640"
            height="800"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: calc(var(--header-h) + 1.5rem) var(--gutter) 1.5rem;
  }

  /* En escritorio la primera hoja ocupa la pantalla inicial, con la
     malla asomando alrededor. */
  @media (min-width: 900px) {
    .hero {
      min-height: 100svh;
      padding-bottom: 2.25rem;
    }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3.5rem;
    }
  }

  .hero-main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.35rem;
  }

  /* ── Estado ───────────────────────────────────────────────── */
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.9rem 0.4rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface-sunken);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  /* ── Nombre ───────────────────────────────────────────────── */
  /* Interlineado holgado: el apellido pinta su degradado con
     background-clip: text, y cualquier trozo de letra que sobresalga de
     la caja de línea queda sin fondo, es decir, invisible. Con la serif,
     un interlineado menor que 1 recortaba las letras. */
  .name {
    display: flex;
    flex-direction: column;
    line-height: 1.02;
    margin-block: 0.25rem;
  }

  .name-line {
    display: block;
  }

  .name-first,
  .name-last {
    display: block;
    /* Más pequeño y menos apretado que con la sans: las letras de una
       serif son más anchas y se pegan si se les quita espacio. */
    font-size: clamp(2.5rem, 9.5vw, 5.6rem);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .name-first {
    font-weight: 300;
  }

  .name-last {
    font-weight: 700;
    padding-bottom: 0.04em;
    /* Degradado sutil: el apellido "pesa" sin gritar. */
    background: linear-gradient(
      100deg,
      var(--ink) 30%,
      color-mix(in srgb, var(--accent) 70%, var(--ink)) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* ── Roles ────────────────────────────────────────────────── */
  .roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.15rem;
  }

  .role {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .role-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .tagline {
    max-width: 44ch;
    font-size: clamp(1.02rem, 1.6vw, 1.15rem);
    color: var(--ink-muted);
    line-height: 1.7;
  }

  /* ── Llamadas a la acción ─────────────────────────────────── */
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }

  .btn-icon {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.3s var(--ease);
  }

  .btn:hover .btn-icon {
    transform: translateX(2px);
  }

  /* ── Retrato ──────────────────────────────────────────────── */
  .hero-portrait {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 21rem;
  }

  @media (min-width: 900px) {
    .hero-portrait {
      justify-self: end;
      max-width: 23rem;
    }
  }

  .frame {
    position: relative;
    padding: 0.6rem;
    border-radius: calc(var(--radius-lg) + 0.35rem);
    background: var(--surface-sunken);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-md);
    transition: transform 0.6s var(--ease);
  }

  .frame:hover {
    transform: translateY(-2px);
  }

  /* Esquinas: eco geométrico de la malla del fondo. */
  .corner {
    position: absolute;
    width: 1.6rem;
    height: 1.6rem;
    border: 2px solid var(--accent);
    opacity: 0.75;
  }

  .corner--tl {
    top: -0.45rem;
    left: -0.45rem;
    border-right: 0;
    border-bottom: 0;
    border-radius: 0.6rem 0 0 0;
  }

  .corner--br {
    bottom: -0.45rem;
    right: -0.45rem;
    border-left: 0;
    border-top: 0;
    border-radius: 0 0 0.6rem 0;
  }

  .photo {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-sunken);
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.9s var(--ease);
  }

  .frame:hover .photo img {
    transform: scale(1.02);
  }

  /* ── Cambio de vista ──────────────────────────────────────── */
  .view-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-muted);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
    transition: color 0.3s var(--ease), text-decoration-color 0.3s var(--ease);
  }

  .view-switch:hover {
    color: var(--accent-strong);
    text-decoration-color: var(--accent);
  }

  .view-switch svg {
    width: 0.95rem;
    height: 0.95rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.3s var(--ease);
  }

  .view-switch:hover svg:last-child {
    transform: translateX(2px);
  }

  .view-switch:hover svg:first-child:not(:last-child) {
    transform: translateX(-2px);
  }
</style>
