---
/**
 * GeometricMesh.astro — Capa de fondo persistente.
 *
 * Vive en el layout, no dentro del Hero: así la malla sigue visible al
 * bajar por todas las secciones, en los márgenes y entre las hojas
 * (.sheet) que contienen el texto.
 */
---

<div class="mesh-layer" aria-hidden="true">
  <div class="orb orb--violet"></div>
  <div class="orb orb--azure"></div>
  <div class="orb orb--grass"></div>
  <canvas id="mesh-canvas" class="mesh-canvas"></canvas>
</div>

<style>
  .mesh-layer {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: var(--bg);
  }

  .mesh-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Halos de color muy difusos: dan profundidad atmosférica detrás
     de la malla sin coste de render por frame. */
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.85;
    animation: orb-drift 26s var(--ease) infinite alternate;
  }

  .orb--violet {
    width: 46vw;
    height: 46vw;
    top: -12vw;
    left: -8vw;
    background: var(--bg-tint-a);
  }

  .orb--azure {
    width: 40vw;
    height: 40vw;
    top: 30vh;
    right: -12vw;
    background: var(--bg-tint-b);
    animation-duration: 34s;
    animation-direction: alternate-reverse;
  }

  .orb--grass {
    width: 32vw;
    height: 32vw;
    bottom: -10vw;
    left: 28vw;
    background: color-mix(in srgb, var(--accent) 9%, transparent);
    animation-duration: 30s;
  }

  @keyframes orb-drift {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(4vw, -3vh, 0) scale(1.14);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orb {
      animation: none;
    }
  }
</style>

<script>
  import { initMesh } from "../scripts/mesh";

  const canvas = document.getElementById("mesh-canvas");
  if (canvas instanceof HTMLCanvasElement) {
    initMesh(canvas);
  }
</script>
